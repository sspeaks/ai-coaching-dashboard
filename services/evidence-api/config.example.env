# Copy values into your service manager; this application does not auto-read .env.
EVIDENCE_ENVIRONMENT=production
EVIDENCE_DATABASE_URL=postgresql+psycopg://evidence_app@postgres/evidence
EVIDENCE_MEDIA_ROOT=/var/lib/evidence/media
EVIDENCE_MAX_UPLOAD_BYTES=5368709120

# The API must only be reachable through these proxy networks (loopback by
# default -- see nix/containers.nix, which runs this service behind a
# dedicated Go proxy-gateway bound to the container's loopback interface).
# oauth2-proxy strips client-supplied forwarded identity/group headers
# before setting them; these header names must match exactly what your
# edge actually forwards, or authentication silently deadlocks.
EVIDENCE_AUTH_MODE=trusted_proxy
EVIDENCE_TRUSTED_EMAIL_HEADER=x-auth-request-email
EVIDENCE_TRUSTED_GROUPS_HEADER=x-auth-request-groups
EVIDENCE_TRUSTED_PROXY_NETWORKS=127.0.0.1/32,::1/128
EVIDENCE_ADMIN_GROUPS=evidence-admins
EVIDENCE_EDITOR_GROUPS=evidence-editors

# Independent, application-level defense-in-depth against a peer container
# reaching this service directly and forging the identity headers above:
# every request in trusted_proxy mode must also present this exact header
# with this exact secret value, checked with a constant-time comparison.
# This is deliberately a *different* header/secret pair from the Go
# proxy-gateway's own hop-auth check (X-AI-Coaching-Proxy-Auth /
# AI_COACHING_PROXY_AUTH_SECRET in nix/containers.nix): the gateway strips
# its header before forwarding, so reusing its name here would make
# legitimate traffic impossible to authenticate. Generate a long random
# value (32+ bytes) and supply it only through your secret manager --
# never commit a real value here, and it is never written to logs.
EVIDENCE_TRUSTED_PROXY_SECRET_HEADER=x-ai-coaching-proxy-auth
EVIDENCE_TRUSTED_PROXY_SHARED_SECRET=

# Deployment integration status: as of this revision, the Nix module does
# not yet inject EVIDENCE_TRUSTED_PROXY_SHARED_SECRET. Until it does, every
# trusted_proxy request is rejected (fail closed) rather than the service
# refusing to start -- see evidence_api/auth.py's require_principal. Wiring
# a generated secret through nix/containers.nix into both this service and
# whatever sits in front of it is tracked as follow-up platform work.

# Server-side only. Supply secrets through the service manager, not this file.
EVIDENCE_SPEAKR_BASE_URL=http://speakr:8899
EVIDENCE_SPEAKR_API_TOKEN=
EVIDENCE_SPEAKR_WEBHOOK_SECRET=
EVIDENCE_SPEAKR_VERIFY_TLS=true
EVIDENCE_WEBHOOK_FRESHNESS_SECONDS=300

# disabled fails extraction jobs clearly; http_json calls a structured AI gateway.
EVIDENCE_EXTRACTION_PROVIDER=disabled
EVIDENCE_EXTRACTION_ENDPOINT=
EVIDENCE_EXTRACTION_API_KEY=
EVIDENCE_RECONCILIATION_INTERVAL_SECONDS=3600
EVIDENCE_WORKER_TRANSCRIPTION_POLL_SECONDS=15
EVIDENCE_WORKER_JOB_LEASE_SECONDS=600
