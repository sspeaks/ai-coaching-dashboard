# Squad: ignore runtime state (logs, inbox, sessions)
# Note: .squad/casting/* is identity and MUST be committed to main, not ignored
.squad/orchestration-log/
.squad/log/
.squad/decisions/inbox/
.squad/sessions/
.squad/.scratch/
.squad/.cache/
# UX screenshots are large regenerable binaries (`cd apps/web && npm run ux:capture`)
# and churn on every UI change; keep REVIEW.md and manifest.json tracked.
.squad/files/ux-review/*/phone-390x844/*.png
.squad/files/ux-review/*/narrow-phone-360x800/*.png
.squad/files/ux-review/*/desktop-1440x900/*.png
# Squad: SubSquad activation file (local to this machine)
.squad-workstream

# Python build products, environments, and caches
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
.venv-*/
venv/
env/
ENV/
.test-runtime/
services/*/tests/.runtime*/

# Frontend dependencies and generated output
node_modules/
apps/web/dist/
packages/web-client/dist/
coverage/
