{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Normalized coaching ledger evaluation input",
  "type": "object",
  "required": ["fixture_id", "transcript_revision", "entries"],
  "properties": {
    "fixture_id": {"type": "string"},
    "transcript_revision": {"type": "integer", "minimum": 1},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "topic",
          "exact_feedback",
          "paraphrase",
          "subject",
          "action",
          "evidence",
          "confidence",
          "uncertainty",
          "verification_state"
        ],
        "properties": {
          "id": {"type": "string"},
          "topic": {"type": "string"},
          "exact_feedback": {"type": "string"},
          "paraphrase": {"type": "string"},
          "subject": {"type": ["string", "null"]},
          "action": {
            "type": "object",
            "required": ["normalized", "polarity", "critical"],
            "properties": {
              "normalized": {"type": "string"},
              "polarity": {"enum": ["positive", "negative"]},
              "critical": {"type": "boolean"}
            }
          },
          "evidence": {
            "type": "object",
            "required": ["feedback"],
            "additionalProperties": {
              "type": "object",
              "required": ["segment_id", "timestamp"],
              "properties": {
                "segment_id": {"type": "string"},
                "timestamp": {"type": "number", "minimum": 0}
              }
            }
          },
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "uncertainty": {"type": ["string", "null"]},
          "verification_state": {
            "enum": ["UNVERIFIED", "VERIFIED", "REJECTED", "NEEDS_CORRECTION"]
          }
        }
      }
    }
  }
}
